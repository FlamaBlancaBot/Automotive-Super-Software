# Frontend environment variables
#
# Copy this file to `frontend/.env`:
#   cp frontend/.env.example frontend/.env
#
# IMPORTANT: Vite only exposes variables prefixed with `VITE_` to the browser.

VITE_APP_NAME=Automotive Super Software
VITE_APP_LONG_NAME=Automotive Super Software
VITE_APP_SHORT_NAME=A.S.S
VITE_TAGLINE=Secure internal garage management
VITE_LOGO_URL=/brand/logo.png

# Backend API base URL (local dev default is http://localhost:3001)
VITE_API_BASE_URL=http://localhost:3001
