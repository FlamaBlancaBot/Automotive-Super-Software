    {
      "parameters": {
        "jsCode": "// Normalise response to the exact shape expected by the backend.\n//\n// Notes:\n// - DVLA and DVSA response fields vary depending on API version.\n// - This code intentionally keeps mapping simple and easy to edit.\n\nconst regNorm = $node['Normalise REG'].json.regNorm;\nconst dvla = $node['DVLA Vehicle Enquiry'].json || {};\nconst motRaw = $node['DVSA MOT History'].json || {};\n\n// DVLA Vehicle Enquiry API commonly returns fields like:\n// - make\n// - colour\n// - fuelType\n// - engineCapacity\n// - yearOfManufacture\n// Some fields such as model are not always present.\n\nconst vehicle = {\n  registration: dvla.registrationNumber || regNorm,\n  make: dvla.make || null,\n  model: dvla.model || null,\n  year: dvla.yearOfManufacture || dvla.year || null,\n  fuel_type: dvla.fuelType || dvla.fuel_type || null,\n  engine_size: dvla.engineCapacity ? `${dvla.engineCapacity}cc` : (dvla.engine_size || null),\n  colour: dvla.colour || dvla.color || null,\n  mot_status: null,\n  mot_expiry: null,\n  last_mot_date: null,\n  last_recorded_mileage: null\n};\n\n// MOT data: keep placeholders for now; adapt once DVSA response is confirmed.\nconst mot = {\n  tests: motRaw.tests || motRaw.motTests || [],\n  failures: motRaw.failures || [],\n  advisories: motRaw.advisories || []\n};\n\nreturn [{ json: { ok: true, source: 'n8n', vehicle, mot } }];\n"
      },
