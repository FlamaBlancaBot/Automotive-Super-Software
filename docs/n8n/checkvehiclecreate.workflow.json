    {
      "parameters": {
        "jsCode": "// Normalise registration and (optionally) validate shared secret.\n//\n// Input body example:\n// { \"registration\": \"AB12CDE\" }\n\nconst body = $json.body || {};\nconst headers = $json.headers || {};\n\nconst rawReg = String(body.registration || '').toUpperCase();\nconst regNorm = rawReg.replace(/[^A-Z0-9]/g, '').trim();\n\nif (!regNorm) {\n  return [{ json: { ok: false, error: 'Missing registration' } }];\n}\n\n// Optional shared secret.\n// Set AUTOSS_WEBHOOK_SECRET in n8n environment variables.\nconst expected = $env.AUTOSS_WEBHOOK_SECRET;\nif (expected) {\n  const provided = String(headers['x-autoss-webhook-secret'] || headers['X-AUTOSS-WEBHOOK-SECRET'] || '');\n  if (!provided || provided !== expected) {\n    return [{ json: { ok: false, error: 'Invalid shared secret' } }];\n  }\n}\n\nreturn [{ json: { regNorm, dvla: { registrationNumber: regNorm } } }];\n"
      },
      "id": "code-normalise",
      "name": "Normalise REG",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
