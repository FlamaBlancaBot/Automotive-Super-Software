# Backend environment variables
#
# Copy this file to `backend/.env`:
#   cp backend/.env.example backend/.env

# Environment
NODE_ENV=production

# HTTP server
PORT=3001

# MySQL/MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Protected browser-based setup (required for /setup)
SETUP_TOKEN=

# n8n vehicle lookup webhook (server-side only)
N8N_CHECK_VEHICLE_WEBHOOK_URL=
N8N_CHECK_VEHICLE_SHARED_SECRET=
N8N_SEND_SMS_WEBHOOK_URL=
N8N_SEND_SMS_SHARED_SECRET=

# Session / app secrets (set real values in production, do not commit)
SESSION_SECRET=

# API keys (do not commit real values)
DVLA_API_KEY=
DVSA_API_KEY=
DVSA_TOKEN_URL=
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
DVSA_SCOPE=

# Optional: CORS (only needed if frontend is on a different domain in development)
# CORS_ORIGIN=http://localhost:5173
